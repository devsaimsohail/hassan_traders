<% locked = item.persisted? && item.stock_moves.exists? %>
<% product = item.product? %>
<%= form_with model: item, class: "grid gap-4 sm:grid-cols-2", data: { controller: "item-form" } do |f| %>
  <% if item.errors.any? %>
    <p class="rounded-lg bg-bad-bg px-3.5 py-2.5 text-[13px] text-bad sm:col-span-2" role="alert"><%= item.errors.full_messages.to_sentence %></p>
  <% end %>

  <fieldset class="flex flex-col gap-1.5 sm:col-span-2" <%= "disabled" if locked %>>
    <legend class="mb-1.5 text-[13px] font-medium text-[#344054]">What kind of item is this?</legend>
    <div class="grid gap-2 sm:grid-cols-2">
      <% { "raw_material" => [ "Raw material", "Kacha maal you buy and use in production, e.g. yarn, cloth, dye" ],
           "product" => [ "Finished goods", "Tayyar maal you sell to customers, e.g. suits, bedsheets" ] }.each do |value, (title, hint)| %>
        <label class="flex cursor-pointer gap-2.5 rounded-lg border border-line p-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft has-[:disabled]:cursor-default">
          <%= f.radio_button :category, value, class: "mt-0.5 accent-[var(--brand)]", data: { item_form_target: "type", action: "change->item-form#update" } %>
          <span><span class="block font-medium"><%= title %></span><span class="block text-xs text-muted"><%= hint %></span></span>
        </label>
      <% end %>
    </div>
    <% if locked %><p class="hint">The type can't change after stock has moved.</p><% end %>
  </fieldset>

  <%= f.label :name, class: "label sm:col-span-2" do %>
    Item name
    <%= f.text_field :name, required: true, autofocus: item.new_record?, placeholder: "e.g. Cotton Yarn 20s or Lawn Suit 3-Piece", class: "input" %>
  <% end %>

  <%= f.label :unit, class: "label" do %>
    Unit <span class="hint">How you count it: kg, meter, pcs, suit…</span>
    <%= f.text_field :unit, required: true, list: "units", class: "input" %>
    <datalist id="units"><% Item::UNITS.each do |u| %><option value="<%= u %>"></option><% end %></datalist>
  <% end %>

  <%= f.label :rate, class: "label" do %>
    Purchase rate (Rs per unit)
    <span class="hint" data-item-form-target="rateHint"><%= product ? "What one unit costs you to buy or make" : "What you pay the supplier per unit" %></span>
    <%= f.number_field :rate, min: 0, step: 1, value: field_number(item, :rate), placeholder: "0", class: "input" %>
  <% end %>

  <div class="sm:col-span-2" data-item-form-target="productOnly" <%= "hidden" unless product %>>
    <%= f.label :sale_price, class: "label" do %>
      Sale price (Rs per unit) <span class="hint">What you normally charge customers. You can change it on each order.</span>
      <%= f.number_field :sale_price, min: 0, step: 1, value: field_number(item, :sale_price), placeholder: "0", class: "input sm:max-w-[calc(50%-0.5rem)]", disabled: !product %>
    <% end %>
  </div>

  <%= f.label :reorder_level, class: "label" do %>
    Reorder level <span class="hint">When stock falls to this, the item shows as Low</span>
    <%= f.number_field :reorder_level, min: 0, step: "any", value: field_number(item, :reorder_level), placeholder: "0", class: "input" %>
  <% end %>

  <%= f.label :opening_qty, class: "label" do %>
    Opening stock <span class="hint"><%= locked ? "Locked: stock has already moved" : "How much you have in the godown today" %></span>
    <%= f.number_field :opening_qty, min: 0, step: "any", value: field_number(item, :opening_qty), placeholder: "0", class: "input", disabled: locked %>
  <% end %>

  <div class="flex gap-2 sm:col-span-2">
    <%= f.submit item.persisted? ? "Save item" : "Add item", class: "btn" %>
    <%= link_to "Cancel", item.persisted? ? item_path(item) : items_path, class: "btn-ghost" %>
  </div>
<% end %>
