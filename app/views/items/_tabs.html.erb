<nav class="flex gap-4 border-b border-line" aria-label="Stock pages">
  <% [ [ "Stock in hand", items_path ], [ "In / out history", stock_moves_path ] ].each do |label, path| %>
    <% on = request.path == path %>
    <%= link_to label, path, class: "-mb-px border-b-2 px-1 pb-2 font-medium #{on ? "border-brand text-brand" : "border-transparent text-muted hover:text-ink"}", aria: { current: (on ? "page" : nil) } %>
  <% end %>
</nav>
<p class="flex items-start gap-2 text-[13px] text-muted">
  <%= icon(:info, classes: "mt-0.5 size-4 shrink-0 text-brand") %>
  Stock goes up only when a purchase order is received. Nobody can add stock by hand, and every change is logged.
</p>
