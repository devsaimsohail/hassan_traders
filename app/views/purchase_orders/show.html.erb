<% po = @purchase_order %>
<% content_for :title, "Purchase order #{po.number}" %>
<% content_for :subtitle, "Bought from #{po.supplier.name}" %>

<div><%= link_to "← Back to purchase orders", purchase_orders_path, class: "btn-link text-[13px]" %></div>
<%= render "purchase_orders/price_changes" %>

<% if po.cancelled? %>
  <p class="rounded-lg bg-chip px-3.5 py-2.5 text-[13px] text-[#344054]">Cancelled by <%= po.cancelled_by.name %> on <%= Fmt.datetime(po.cancelled_at) %>: <%= po.cancel_reason %></p>
<% elsif po.draft? %>
  <p class="rounded-lg bg-chip px-3.5 py-2.5 text-[13px] text-[#344054]">This is a draft. It has not been sent yet, and nothing happens until it is.</p>
<% end %>

<section class="card flex flex-col gap-4 p-4" id="purchase-order">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <h2 class="text-lg font-semibold"><%= po.number %></h2>
    <div class="flex flex-wrap items-center gap-1.5">
      <%= link_to purchase_order_path(po, format: :pdf), class: "btn btn-sm", data: { turbo: false } do %><%= icon(:pdf, classes: "size-4") %> Download PDF<% end %>
      <% if policy(po).submit? %><%= button_to (Current.access.can?(:purchase_approve) ? "Approve" : "Send for approval"), submit_purchase_order_path(po), class: "btn-ghost btn-sm" %><% end %>
      <% if policy(po).approve? %><%= button_to "Approve", approve_purchase_order_path(po), class: "btn-ghost btn-sm" %><% end %>
      <% if policy(po).edit? %><%= link_to "Edit draft", edit_purchase_order_path(po), class: "btn-ghost btn-sm" %><% end %>
      <% if policy(po).copy? %><%= link_to "Make a copy", copy_purchase_order_path(po), class: "btn-ghost btn-sm" %><% end %>
      <% if policy(po).destroy? %><%= button_to "Delete draft", purchase_order_path(po), method: :delete, class: "btn-ghost btn-sm text-bad", form: { data: { turbo_confirm: "Delete this draft? This is logged." } } %><% end %>
    </div>
  </div>

  <dl class="grid grid-cols-[repeat(auto-fit,minmax(9rem,1fr))] gap-x-5 gap-y-3">
    <% [ [ "Supplier", po.supplier.name ], [ "PO date", Fmt.date(po.date) ], [ "Made by", po.created_by.name ],
         [ "Approved by", po.approved_by&.name || "Not yet" ], [ "Goods received", po.received_on ? "#{Fmt.date(po.received_on)} by #{po.received_by.name}" : "Not yet" ],
         [ "Supplier payment", po.pay_status ] ].each do |label, value| %>
      <div><dt class="text-xs text-muted"><%= label %></dt><dd class="font-medium"><%= value %></dd></div>
    <% end %>
  </dl>

  <div class="grid grid-cols-[repeat(auto-fit,minmax(9rem,1fr))] rounded-lg border border-line-soft bg-[#FAFBFC]">
    <% [ [ "PO total", Fmt.rs(po.total), nil ], [ "Paid", Fmt.rs(po.paid), "text-ok" ], [ "To pay", Fmt.rs(po.balance), (po.balance.positive? ? "text-bad" : nil) ] ].each do |label, value, tone| %>
      <div class="border-l border-line-soft px-3.5 py-2.5 first:border-l-0">
        <div class="text-xs text-muted"><%= label %></div>
        <div class="text-lg font-semibold tabular-nums whitespace-nowrap <%= tone %>"><%= value %></div>
      </div>
    <% end %>
  </div>

  <% if policy(po).receive? || policy(po).pay? || policy(po).cancel? %>
    <div class="flex flex-col gap-2 border-t border-line-soft pt-3">
      <% if policy(po).receive? %>
        <%= form_with url: receive_purchase_order_path(po), class: "flex flex-wrap items-end gap-2" do |f| %>
          <%= f.label :received_on, class: "label" do %>Goods received on<%= f.date_field :received_on, value: Date.current, class: "input min-h-8 py-1" %><% end %>
          <%= f.submit "Receive goods into the godown", class: "btn btn-sm", data: { turbo_confirm: "Receive everything on #{po.number}? Stock goes up for each item." } %>
        <% end %>
      <% end %>
      <% if policy(po).pay? %>
        <details id="pay" class="rounded-lg border border-line-soft px-3 py-2" <%= "open" if params[:anchor] == "pay" %>>
          <summary class="cursor-pointer text-[13px] font-medium">Pay supplier · <%= Fmt.rs(po.balance) %> still to pay</summary>
          <%= form_with scope: :payment, url: pay_purchase_order_path(po), class: "mt-3 grid gap-3 sm:grid-cols-4" do |f| %>
            <%= f.label :amount, class: "label" do %>Amount (Rs)<%= f.number_field :amount, value: po.balance, min: 1, max: po.balance, required: true, class: "input" %><% end %>
            <%= f.label :method, class: "label" do %>Method<%= f.select :method, SupplierPayment::METHODS.invert, {}, class: "input" %><% end %>
            <%= f.label :ref, class: "label" do %>Cheque no. / TID <span class="hint">Not needed for cash</span><%= f.text_field :ref, class: "input" %><% end %>
            <%= f.label :date, class: "label" do %>Date<%= f.date_field :date, value: Date.current, class: "input" %><% end %>
            <div class="sm:col-span-4"><%= f.submit "Save payment", class: "btn btn-sm" %></div>
          <% end %>
        </details>
      <% end %>
      <% if policy(po).cancel? %>
        <details class="rounded-lg border border-line-soft px-3 py-2">
          <summary class="cursor-pointer text-[13px] font-medium text-bad">Cancel this PO</summary>
          <%= form_with url: cancel_purchase_order_path(po), class: "mt-3 flex flex-wrap items-end gap-2" do |f| %>
            <%= f.label :reason, class: "label min-w-64 flex-1" do %>Reason<%= f.text_field :reason, required: true, placeholder: "e.g. rate too high, will buy elsewhere", class: "input" %><% end %>
            <%= f.submit "Cancel PO", class: "btn-ghost btn-sm text-bad" %>
          <% end %>
        </details>
      <% end %>
    </div>
  <% end %>
</section>

<section class="card overflow-hidden" id="po-lines">
  <h2 class="px-4 pt-4 pb-2 text-[15px] font-semibold">Items ordered</h2>
  <table class="table">
    <thead><tr><th>Item</th><th class="text-right">Qty</th><th>Unit</th><th class="text-right">Rate</th><th class="text-right">Amount</th></tr></thead>
    <tbody>
      <% po.lines.each do |line| %>
        <tr class="cursor-pointer hover:bg-hover" data-controller="row-link" data-action="click->row-link#open" data-row-link-href-value="<%= item_path(line.item) %>">
          <td class="whitespace-nowrap"><%= line.item.name %></td>
          <td class="text-right tabular-nums"><%= Fmt.qty(line.qty) %></td>
          <td><%= line.item.unit %></td>
          <td class="text-right tabular-nums"><%= Fmt.rate(line.rate) %></td>
          <td class="text-right font-medium tabular-nums"><%= Fmt.rs(line.amount) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<% if @moves.any? %>
  <section class="card overflow-hidden" id="po-received">
    <h2 class="px-4 pt-4 pb-2 text-[15px] font-semibold">Goods received in godown</h2>
    <table class="table">
      <thead><tr><th>Date</th><th>Item</th><th class="text-right">Qty</th><th>Received by</th></tr></thead>
      <tbody>
        <% @moves.each do |move| %>
          <tr><td class="whitespace-nowrap"><%= Fmt.date(move.date) %></td><td><%= move.item.name %></td><td class="text-right tabular-nums"><%= Fmt.qty(move.qty) %> <%= move.item.unit %></td><td><%= move.user&.name %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<% if @payments.any? %>
  <section class="card overflow-hidden" id="po-payments">
    <h2 class="px-4 pt-4 pb-2 text-[15px] font-semibold">Payments to supplier</h2>
    <table class="table">
      <thead><tr><th>Date</th><th>Method</th><th>Cheque / TID</th><th class="text-right">Amount</th><th>Paid by</th></tr></thead>
      <tbody>
        <% @payments.each do |payment| %>
          <tr><td class="whitespace-nowrap"><%= Fmt.date(payment.date) %></td><td><%= payment.method_label %></td><td><%= payment.ref %></td><td class="text-right font-medium tabular-nums"><%= Fmt.rs(payment.amount) %></td><td><%= payment.user.name %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
