<nav class="flex gap-4 border-b border-line" aria-label="Purchase pages">
  <% [ [ "Purchase orders", purchase_orders_path ], [ "Suppliers", suppliers_path ] ].each do |label, path| %>
    <% on = request.path == path %>
    <%= link_to label, path, class: "-mb-px border-b-2 px-1 pb-2 font-medium #{on ? "border-brand text-brand" : "border-transparent text-muted hover:text-ink"}", aria: { current: (on ? "page" : nil) } %>
  <% end %>
</nav>
