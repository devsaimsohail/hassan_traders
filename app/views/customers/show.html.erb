<% c = @customer %>
<% content_for :title, c.name %>
<% content_for :subtitle, [ c.place.presence, "code #{c.code}" ].compact.join(" · ") %>

<div><%= link_to "← Back to customers", customers_path, class: "btn-link text-[13px]" %></div>

<section class="card flex flex-col gap-4 p-4" id="customer">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <h2 class="text-lg font-semibold"><%= c.name %></h2>
    </div>
    <div class="flex flex-wrap gap-1.5">
      <% if policy(:khata).show? %><%= link_to "Open khata", khata_path(customer_id: c.id), class: "btn btn-sm" %><% end %>
      <% if policy(Payment).create? %><%= link_to new_payment_path(customer_id: c.id), class: "btn-ghost btn-sm" do %><%= icon(:plus, classes: "size-4") %> Receive payment<% end %><% end %>
      <% if policy(SalesOrder).create? %><%= link_to new_sales_order_path(customer_id: c.id), class: "btn-ghost btn-sm" do %><%= icon(:plus, classes: "size-4") %> New order<% end %><% end %>
      <% if policy(c).update? %><%= link_to "Edit details", edit_customer_path(c), class: "btn-ghost btn-sm" %><% end %>
    </div>
  </div>

  <dl class="grid grid-cols-[repeat(auto-fit,minmax(9rem,1fr))] gap-x-5 gap-y-3">
    <% [ [ "Mobile", c.phone.presence || "Not set" ], [ "City", c.city.presence || "Not set" ], [ "Opening balance", Fmt.rs(c.opening_balance) ],
         [ "Last payment", c.last_payment ? Fmt.date(c.last_payment) : "None yet" ] ].each do |label, value| %>
      <div><dt class="text-xs text-muted"><%= label %></dt><dd class="font-medium"><%= value %></dd></div>
    <% end %>
  </dl>

  <% if c.note.present? %>
    <p class="rounded-lg bg-warn-bg px-3.5 py-2.5 text-[13px] text-warn"><%= c.note %></p>
  <% end %>

  <div class="grid grid-cols-[repeat(auto-fit,minmax(9rem,1fr))] rounded-lg border border-line-soft bg-[#FAFBFC]">
    <% [ [ "Total bills", Fmt.rs(c.billed), nil ], [ "Received", Fmt.rs(c.received), "text-ok" ],
         [ "Owes you", Fmt.rs(c.balance), (c.balance.positive? ? "text-bad" : nil) ], [ "Past due", Fmt.rs(c.overdue), (c.overdue.positive? ? "text-bad" : nil) ] ].each do |label, value, tone| %>
      <div class="border-l border-line-soft px-3.5 py-2.5 first:border-l-0">
        <div class="text-xs text-muted"><%= label %></div>
        <div class="text-lg font-semibold tabular-nums whitespace-nowrap <%= tone %>"><%= value %></div>
      </div>
    <% end %>
  </div>
</section>

<% if policy(Invoice).index? %>
  <section class="card overflow-hidden" id="unpaid-bills">
    <div class="flex items-baseline justify-between gap-3 px-4 pt-4 pb-2"><h2 class="text-[15px] font-semibold">Unpaid bills</h2><span class="text-xs text-muted">Oldest due date first</span></div>
    <% if @unpaid_bills.any? %>
      <table class="table">
        <thead><tr><th>Bill #</th><th>Date</th><th>Due</th><th class="text-right">Baqaya</th><th>Status</th></tr></thead>
        <tbody>
          <% @unpaid_bills.each do |bill| %>
            <tr class="cursor-pointer hover:bg-hover" data-controller="row-link" data-action="click->row-link#open" data-row-link-href-value="<%= invoice_path(bill) %>">
              <td class="whitespace-nowrap"><%= bill.number %></td><td class="whitespace-nowrap"><%= Fmt.date(bill.date) %></td><td class="whitespace-nowrap"><%= Fmt.date(bill.due_date) %></td>
              <td class="text-right font-medium tabular-nums"><%= Fmt.rs(bill.balance) %></td><td><%= pill(bill.status, InvoiceList::STATUS_TONES[bill.status]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-4 pb-4 text-muted">No unpaid bills.</p>
    <% end %>
  </section>
<% end %>

<% if policy(Payment).index? %>
  <section class="card overflow-hidden" id="latest-payments">
    <h2 class="px-4 pt-4 pb-2 text-[15px] font-semibold">Latest payments</h2>
    <% if @payments.any? %>
      <table class="table">
        <thead><tr><th>Receipt #</th><th>Date</th><th>Method</th><th class="text-right">Amount</th><th></th></tr></thead>
        <tbody>
          <% @payments.each do |pay| %>
            <tr class="cursor-pointer hover:bg-hover" data-controller="row-link" data-action="click->row-link#open" data-row-link-href-value="<%= payment_path(pay) %>">
              <td class="whitespace-nowrap"><%= pay.number %></td><td class="whitespace-nowrap"><%= Fmt.date(pay.date) %></td><td><%= pay.method_label %></td>
              <td class="text-right font-medium tabular-nums <%= "text-muted line-through" if pay.reversed? %>"><%= Fmt.rs(pay.amount) %></td><td><%= pill("Reversed", "pill-bad") if pay.reversed? %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-4 pb-4 text-muted">No payments yet.</p>
    <% end %>
  </section>
<% end %>

<% if policy(SalesOrder).index? %>
  <section class="card overflow-hidden" id="latest-orders">
    <h2 class="px-4 pt-4 pb-2 text-[15px] font-semibold">Latest orders</h2>
    <% if @orders.any? %>
      <table class="table">
        <thead><tr><th>Order #</th><th>Date</th><th class="text-right">Amount</th><th>Status</th></tr></thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr class="cursor-pointer hover:bg-hover" data-controller="row-link" data-action="click->row-link#open" data-row-link-href-value="<%= sales_order_path(order) %>">
              <td class="whitespace-nowrap"><%= order.number %></td><td class="whitespace-nowrap"><%= Fmt.date(order.date) %></td>
              <td class="text-right font-medium tabular-nums"><%= Fmt.rs(order.amount) %></td><td><%= pill(order.status_label, SalesOrderList::STATUS_TONES[order.status_label]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-4 pb-4 text-muted">No orders yet.</p>
    <% end %>
  </section>
<% end %>
