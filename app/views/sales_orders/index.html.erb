<% content_for :title, "Sales orders" %>
<% content_for :subtitle, "Orders from customers. Dispatching an order takes the goods out of stock and makes the bill." %>
<% content_for :view_only, "1" unless policy(SalesOrder).create? || Current.access.can?(:stock_receive) %>
<%= render "lists/list", list: @list, row_path: ->(so) { sales_order_path(so) },
      actions: (link_to(new_sales_order_path, class: "btn btn-sm") { icon(:plus, classes: "size-4") + " New order" } if policy(SalesOrder).create?) %>
