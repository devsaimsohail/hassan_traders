<% so = @sales_order %>
<% content_for :title, "Sales order #{so.number}" %>
<% content_for :subtitle, "Order from #{so.customer.name}#{", #{so.customer.city}" if so.customer.city}" %>
<% tones = SalesOrderList::STATUS_TONES %>

<div><%= link_to "← Back to sales orders", sales_orders_path, class: "btn-link text-[13px]" %></div>

<% if so.cancelled? %>
  <p class="rounded-lg bg-chip px-3.5 py-2.5 text-[13px] text-[#344054]">Cancelled by <%= so.cancelled_by.name %> on <%= Fmt.datetime(so.cancelled_at) %>: <%= so.cancel_reason %></p>
<% end %>

<section class="card flex flex-col gap-4 p-4" id="sales-order">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="flex items-center gap-2.5"><h2 class="text-lg font-semibold"><%= so.number %></h2><%= pill(so.status_label, tones[so.status_label]) %></div>
    <div class="flex flex-wrap items-center gap-1.5">
      <%= link_to sales_order_path(so, format: :pdf), class: "btn btn-sm", data: { turbo: false } do %><%= icon(:pdf, classes: "size-4") %> Download PDF<% end %>
      <% if so.invoice && policy(so.invoice).show? %><%= link_to "Open bill #{so.invoice.number}", invoice_path(so.invoice), class: "btn-ghost btn-sm" %><% end %>
      <% if policy(so.customer).show? %><%= link_to "Customer", customer_path(so.customer), class: "btn-ghost btn-sm" %><% end %>
      <% if policy(so).deliver? %><%= button_to "Mark delivered", deliver_sales_order_path(so), class: "btn-ghost btn-sm" %><% end %>
    </div>
  </div>

  <%= render "shared/facts", facts: [ [ "Customer", so.customer.name ], [ "City", so.customer.city.presence || "Not set" ], [ "Order date", Fmt.date(so.date) ],
        [ "Booked by", so.booked_by.name ], [ "Dispatched", so.dispatched_on ? "#{Fmt.date(so.dispatched_on)} by #{so.dispatched_by.name}" : "Not yet" ],
        [ "Bill", so.invoice&.number || "Made when dispatched" ], (so.delivered_on && [ "Delivered", Fmt.date(so.delivered_on) ]),
        (so.note.present? && [ "Note", so.note ]) ].select(&:itself) %>
  <%= render "shared/money_strip", figures: [ [ "Order amount", Fmt.rs(so.amount) ] ] %>

  <% if policy(so).dispatch? || policy(so).cancel? %>
    <div class="flex flex-col gap-2 border-t border-line-soft pt-3">
      <% if policy(so).dispatch? %>
        <%= form_with url: dispatch_goods_sales_order_path(so), class: "flex flex-wrap items-end gap-2" do |f| %>
          <%= f.label :dispatched_on, class: "label" do %>Dispatched on<%= f.date_field :dispatched_on, value: Date.current, class: "input min-h-8 py-1" %><% end %>
          <%= f.submit "Dispatch and make bill", class: "btn btn-sm", data: { turbo_confirm: "Dispatch #{so.number}? Stock goes down and the bill is made." } %>
        <% end %>
      <% end %>
      <% if policy(so).cancel? %>
        <details class="rounded-lg border border-line-soft px-3 py-2">
          <summary class="cursor-pointer text-[13px] font-medium text-bad">Cancel this order</summary>
          <%= form_with url: cancel_sales_order_path(so), class: "mt-3 flex flex-wrap items-end gap-2" do |f| %>
            <%= f.label :reason, class: "label min-w-64 flex-1" do %>Reason<%= f.text_field :reason, required: true, placeholder: "e.g. stock not available, cancelled by customer", class: "input" %><% end %>
            <%= f.submit "Cancel order", class: "btn-ghost btn-sm text-bad" %>
          <% end %>
        </details>
      <% end %>
    </div>
  <% end %>
</section>

<section class="card overflow-hidden" id="order-lines">
  <h2 class="px-4 pt-4 pb-2 text-[15px] font-semibold">Items</h2>
  <table class="table">
    <thead><tr><th>Item</th><th class="text-right">Qty</th><th>Unit</th><th class="text-right">Rate</th><th class="text-right">Amount</th></tr></thead>
    <tbody>
      <% so.lines.each do |line| %>
        <tr><td class="whitespace-nowrap"><%= line.item.name %></td><td class="text-right tabular-nums"><%= Fmt.qty(line.qty) %></td><td><%= line.item.unit %></td>
          <td class="text-right tabular-nums"><%= Fmt.rate(line.rate) %></td><td class="text-right font-medium tabular-nums"><%= Fmt.rs(line.amount) %></td></tr>
      <% end %>
    </tbody>
  </table>
</section>

<% if @moves.any? %>
  <section class="card overflow-hidden" id="order-dispatched">
    <h2 class="px-4 pt-4 pb-2 text-[15px] font-semibold">Dispatched from godown</h2>
    <table class="table">
      <thead><tr><th>Date</th><th>Item</th><th class="text-right">Qty</th><th>Dispatched by</th></tr></thead>
      <tbody>
        <% @moves.each do |move| %>
          <tr><td class="whitespace-nowrap"><%= Fmt.date(move.date) %></td><td><%= move.item.name %></td><td class="text-right tabular-nums"><%= Fmt.qty(move.qty) %> <%= move.item.unit %></td><td><%= move.user&.name %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
