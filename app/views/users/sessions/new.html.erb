<% content_for :title, "Log in" %>
<div class="card p-6">
  <h1 class="text-lg font-semibold">Log in</h1>
  <p class="mt-1 text-[13px] text-muted">Use your mobile number and password.</p>

  <%= form_with model: resource, scope: resource_name, url: user_session_path, class: "mt-5 flex flex-col gap-4" do |f| %>
    <%= f.label :mobile, class: "label" do %>
      Mobile number
      <%= f.telephone_field :mobile, required: true, autofocus: true, autocomplete: "username", inputmode: "tel", placeholder: "0300-1234567", class: "input" %>
    <% end %>
    <%= f.label :password, class: "label" do %>
      Password
      <%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
    <% end %>
    <label class="flex items-center gap-2 text-[13px] text-muted">
      <%= f.check_box :remember_me %> Keep me logged in on this computer
    </label>
    <%= f.submit "Log in", class: "btn w-full" %>
  <% end %>
  <p class="mt-4 text-xs text-muted">Forgot your password? Ask a partner to reset it.</p>
</div>
