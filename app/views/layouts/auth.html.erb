<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), "Hassan Traders" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="grid min-h-screen place-items-center bg-page px-4 font-sans text-sm text-ink antialiased">
    <main class="w-full max-w-sm py-10">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
